# Αντίγραψέ το σε .env και συμπλήρωσε τιμές.
# Δημιουργία μυστικού: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
DATABASE_URI=postgres://argolidastay:argolidastay@127.0.0.1:5432/argolidastay
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# SMS (προαιρετικό — αν λείπει, δεν στέλνονται SMS)
SMS_PROVIDER=none
SMS_API_KEY=
SMS_SENDER=ArgolidaStay

# Κοινή βάση για δύο άτομα πριν στηθεί ο server (προαιρετικό).
# Αν οριστεί, το docker-compose.local.yml τη χρησιμοποιεί αντί για την τοπική.
SHARED_DATABASE_URI=
